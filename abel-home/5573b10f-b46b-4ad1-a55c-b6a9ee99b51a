/* ---------- 写真差し替え枠（提案用プレースホルダ） ----------
   開発者向けの大きな文言は出さず、控えめな画像アイコン＋小さな注記で
   「ここに実写真が入る」ことが伝わるようにする。 */
function Frame({ tone = "wood", ratio, radius = "0", minHeight, kicker, note = true, style = {}, children }) {
  const TONES = {
    soil: "var(--c-soil)", wood: "var(--c-wood-deep)", moss: "var(--c-moss)",
    sumi: "var(--c-sumi)", clay: "#A8694A", shikkui: "var(--c-shikkui-sunken)", kawara: "var(--c-kawara)",
  };
  const bg = TONES[tone] || tone;
  return (
    <div style={{
      position: "relative", aspectRatio: ratio, minHeight, borderRadius: radius,
      background: `linear-gradient(135deg, ${bg}, color-mix(in srgb, ${bg} 78%, #2A2521))`,
      overflow: "hidden", display: "flex", alignItems: "center", justifyContent: "center", ...style,
    }}>
      {!children && (
        <div style={{ display: "flex", flexDirection: "column", alignItems: "center", gap: 10, opacity: 0.5 }}>
          <window.Icon name="image" size={40} color="rgba(255,255,255,.9)" stroke={1.4} />
        </div>
      )}
      {kicker && (
        <span style={{ position: "absolute", top: 12, left: 12, display: "inline-flex", alignItems: "center", gap: 6,
          background: "rgba(42,37,33,.55)", color: "#fff", borderRadius: "var(--radius-pill)",
          padding: "5px 11px", font: "var(--fw-medium) 11px/1 var(--font-gothic)", letterSpacing: ".06em", backdropFilter: "blur(2px)" }}>{kicker}</span>
      )}
      {note && !children && (
        <span style={{ position: "absolute", bottom: 10, right: 12,
          font: "10.5px/1 var(--font-body)", color: "rgba(255,255,255,.78)", letterSpacing: ".02em" }}>写真差し替え予定</span>
      )}
      {children}
    </div>
  );
}

function Container({ width = "var(--container)", style, children }) {
  return <div style={{ width: "100%", maxWidth: width, margin: "0 auto", padding: "0 24px", ...style }}>{children}</div>;
}

/* 「確認中」を表す小さなタグ（未確認情報の明示用） */
function Provisional({ children = "確認中", style }) {
  return (
    <span style={{ display: "inline-flex", alignItems: "center", gap: 5, verticalAlign: "middle",
      background: "var(--c-warning-tint)", color: "#8A6418", border: "1px solid color-mix(in srgb, #C2913C 40%, transparent)",
      borderRadius: "var(--radius-sm)", padding: "2px 8px", font: "var(--fw-medium) 11px/1.4 var(--font-gothic)", letterSpacing: ".02em", ...style }}>{children}</span>
  );
}

