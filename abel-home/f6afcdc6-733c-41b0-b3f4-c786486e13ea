/* Sections.jsx — 実績ストリップ / 施工事例 / 選ばれる理由 / お客様の声 / 相談の流れ / 会社案内
   ※提案ラフ：未確認情報は安全表現＋確認中タグ。事例・声は掲載イメージと明示。 */

/* 下層ページ想定リンク（同セクションに戻らないことを明示） */
function LowerPageLink({ label, onClick }) {
  const { Button } = window.YUI_195e4a;
  return (
    <div style={{ display: "flex", flexDirection: "column", alignItems: "flex-end", gap: 6 }}>
      <Button variant="secondary" withArrow onClick={(e) => { e.preventDefault(); onClick && onClick(); }}>{label}</Button>
      <span style={{ font: "11px/1 var(--font-body)", color: "var(--text-muted)" }}>※別ページ（一覧）に遷移予定</span>
    </div>
  );
}

/* ---------- 実績ストリップ（墨の濃色帯・安全表現） ---------- */
function StatsStrip() {
  const { STATS } = window;
  return (
    <div style={{ background: "var(--color-ink-surface)", color: "var(--text-on-dark)" }}>
      <div className="stats-row" style={{ maxWidth: "var(--container)", margin: "0 auto", padding: "20px 24px", display: "flex", gap: 36, flexWrap: "wrap", justifyContent: "center", alignItems: "baseline" }}>
        {STATS.map((s, i) => (
          <div key={i} style={{ display: "flex", alignItems: "baseline", gap: 8 }}>
            <span style={{ font: "12px/1 var(--font-body)", color: "rgba(245,241,234,.66)" }}>{s[0]}</span>
            <span style={{ fontFamily: "var(--font-gothic)", fontWeight: 700, fontSize: 20, letterSpacing: ".02em" }}>{s[1]}</span>
            <span style={{ font: "11px/1.4 var(--font-body)", color: "rgba(245,241,234,.6)" }}>{s[2]}</span>
          </div>
        ))}
      </div>
    </div>
  );
}

/* ---------- 施工事例（掲載イメージ／課題→工事→結果の短文） ---------- */
function WorkCard({ w, onJump }) {
  const { Frame, Icon } = window;
  const { Tag } = window.YUI_195e4a;
  const [hover, setHover] = React.useState(false);
  return (
    <a onClick={(e) => { e.preventDefault(); onJump("works-detail"); }}
      onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)}
      style={{ display: "block", textDecoration: "none", cursor: "pointer" }}>
      <div style={{ overflow: "hidden", borderRadius: "var(--radius-md)", boxShadow: hover ? "var(--shadow-md)" : "var(--shadow-xs)", transition: "var(--transition-base)" }}>
        <div style={{ transform: hover ? "scale(1.04)" : "none", transition: "var(--transition-base)" }}>
          <Frame tone={w.tone} ratio="4 / 3" kicker="Before / After" />
        </div>
      </div>
      <div style={{ paddingTop: 16 }}>
        <div style={{ display: "flex", flexWrap: "wrap", gap: 6, marginBottom: 10 }}>
          {w.tags.map((t, i) => <Tag key={i} tone={t.tone || "neutral"}>{t.label}</Tag>)}
        </div>
        <h3 style={{ fontFamily: "var(--font-serif)", fontWeight: 500, fontSize: "var(--fs-h3)", lineHeight: "var(--lh-heading)", letterSpacing: "var(--ls-normal)", color: hover ? "var(--c-kawara)" : "var(--text-primary)", margin: 0, transition: "var(--transition-fast)", textWrap: "pretty" }}>{w.title}</h3>
        <p style={{ font: "13.5px/1.8 var(--font-body)", color: "var(--text-secondary)", marginTop: 10, textWrap: "pretty" }}>{w.summary}</p>
      </div>
    </a>
  );
}

function WorksSection({ onJump }) {
  const { Container, WORKS } = window;
  const { SectionHeading } = window.YUI_195e4a;
  return (
    <section data-screen-label="施工事例" className="sec" style={{ background: "var(--color-surface)", padding: "var(--section-y) 0" }}>
      <Container width="var(--container-wide)">
        <div className="head-row" style={{ display: "flex", alignItems: "flex-end", justifyContent: "space-between", gap: 20, flexWrap: "wrap" }}>
          <div>
            <SectionHeading label="Works" title="施工事例" lead="ビフォーアフターと、工事の内容が一目で分かるように。" />
            <div style={{ marginTop: 10, font: "12px/1.6 var(--font-body)", color: "var(--text-muted)" }}>※下記はレイアウト確認用の掲載イメージです。実際の施工事例に差し替えます。</div>
          </div>
          <LowerPageLink label="施工事例一覧へ" onClick={() => onJump("works-detail")} />
        </div>
        <div className="resp-grid-3" style={{ display: "grid", gridTemplateColumns: "repeat(3,1fr)", gap: 28, marginTop: 40 }}>
          {WORKS.map((w, i) => <WorkCard key={i} w={w} onJump={onJump} />)}
        </div>
      </Container>
    </section>
  );
}

