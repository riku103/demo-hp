/* ---------- 相談の流れ ---------- */
function FlowSection({ onJump }) {
  const { Container, FLOW } = window;
  const { SectionHeading, FlowStep, Button } = window.YUI_195e4a;
  return (
    <section data-screen-label="相談の流れ" className="sec" style={{ background: "var(--c-shikkui-sunken)", padding: "var(--section-y) 0" }}>
      <Container>
        <div className="resp-flow" style={{ display: "grid", gridTemplateColumns: "0.85fr 1.15fr", gap: 56, alignItems: "start" }}>
          <div className="flow-aside">
            <SectionHeading label="Flow" title="相談の流れ"
              lead="はじめてのリフォームも、見通しがあれば安心です。相談から工事のあとまで、ご一緒に。" />
            <div style={{ marginTop: 26 }}>
              <Button variant="primary" withArrow onClick={() => onJump("contact")}>まずは無料で相談する</Button>
            </div>
          </div>
          <div>
            {FLOW.map((s, i) => (
              <FlowStep key={s.step} step={s.step} title={s.title} body={s.body} meta={s.meta} isLast={i === FLOW.length - 1} />
            ))}
          </div>
        </div>
      </Container>
    </section>
  );
}

