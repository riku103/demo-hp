  return (
    <section data-screen-label="会社案内" className="sec" style={{ background: "var(--color-bg)", padding: "var(--section-y) 0" }}>
      <Container>
        <div className="resp-company" style={{ display: "grid", gridTemplateColumns: "1.1fr 0.9fr", gap: 56, alignItems: "center" }}>
          <div>
            <SectionHeading label="Company" title="岡山の住まいを、地元で支える。"
              lead="アベルホームは、岡山に根ざした住宅リフォームの会社です。小さな修繕から、まるごと改装まで。地域の暮らしに寄り添います。" />
            <div style={{ marginTop: 26, border: "1px solid var(--border)", borderRadius: "var(--radius-md)", overflow: "hidden", background: "var(--color-surface)" }}>
