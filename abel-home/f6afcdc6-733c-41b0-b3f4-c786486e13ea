      <div style={{ padding: "22px 24px 24px", display: "flex", flexDirection: "column", flex: 1 }}>
        <div style={{ fontFamily: "var(--font-serif)", fontSize: 32, lineHeight: 1, height: 16, color: "var(--c-wood)", marginBottom: 6 }}>“</div>
        <p style={{ fontFamily: "var(--font-serif)", fontWeight: 400, fontSize: "var(--fs-body-lg)", lineHeight: "var(--lh-snug)", letterSpacing: "var(--ls-normal)", color: "var(--text-primary)", margin: 0, flex: 1, textWrap: "pretty" }}>{v.quote}</p>
        <div style={{ marginTop: 16, paddingTop: 14, borderTop: "1px solid var(--border-faint)" }}>
